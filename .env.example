CREDENTIAL_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=
PRODUCT_DOMAIN=
# Only the super admin configures shared provider keys. No customer-owned keys.
ADMIN_EMAILS=kamzewac@gmail.com
ADMIN_USER_IDS=
AI_DAILY_BUDGET_USD=10
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_KEY=
# Keep all secrets server-side. Never add NEXT_PUBLIC_ prefixes to secret keys.

# Transactional invitations, bookings, and verified live purchase confirmations.
# Sender must be verified in Resend. Missing configuration retains queued mail.
RESEND_API_KEY=
EMAIL_FROM=

# Paddle pricing checkout. Explicit environment required; there is no fallback.
# These IDs belong to the live one-time catalog. See docs/paddle-live-mapping.json.
# Keep this profile local/staging until verification and all checkout domains pass.
PADDLE_ENVIRONMENT=production
PADDLE_LIVE_RELEASE=staging
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_STARTER=pri_01m2a5d64xpnf4wwtp94n62vxh
PADDLE_PRICE_PRO=pri_01m2a5d5gwe5fc9y631bxcrp5s
PADDLE_PRICE_ADVANCED=pri_01m2a5d4w5qa8m4jhhfr6dc06t
# A client-side token starts with test_ (sandbox) or live_ (production).
# Never place a Paddle server API key in PADDLE_CLIENT_TOKEN or client code.
# Server-only credentials. API key requires customer read + portal session write.
PADDLE_API_KEY=
# Notification destination endpoint signing secret, NOT the ntfset_ ID or API key.
PADDLE_WEBHOOK_SECRET=
# direct on local Node; render only behind Render's managed ingress.
# Live delivery fails closed when mode is missing or IP list refresh fails.
PADDLE_WEBHOOK_IP_MODE=direct
# Optional recurring catalog. Never put a one-time pack ID in these fields.
# Leave blank to keep a proposed plan unavailable until its catalog is configured.
PADDLE_SUB_PRO_MONTH=
PADDLE_SUB_PRO_YEAR=
PADDLE_SUB_STUDIO_MONTH=
PADDLE_SUB_STUDIO_YEAR=

# New purchases: Apple Pay and Google Pay, processed by Stripe.
# Keys must match this explicit mode. Keep checkout disabled until wallet QA passes.
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_WALLET_CHECKOUT_ENABLED=false
# Signing secret for /api/webhooks/wallet; separate from the API key.
STRIPE_WALLET_WEBHOOK_SECRET=
# Optional dedicated portal configuration (invoices + cancel at period end).
STRIPE_WALLET_PORTAL_CONFIGURATION=
# Paddle variables above remain for existing customer fulfillment and billing.
# They no longer enable new purchases on /pricing.

# Opt-in file-sale publication and checkout. Also requires STRIPE_MODE=test.
# Private draft creation, uploads, editing and preview do not require this flag.
# Keep disabled in production. Buyer entitlements remain readable when disabled.
FIVEGEN_FILE_SALES_ENABLED=false
# Creator sales use separate Stripe Connect direct charges, not AI-credit billing.
# Complete test-mode verification before enabling a live environment.
STRIPE_COMMERCE_ENABLED=false
# Optional server-only Connect key; blank uses STRIPE_SECRET_KEY.
# Must match STRIPE_MODE. Does not change the platform subscription key.
STRIPE_COMMERCE_SECRET_KEY=
# Connected-account snapshot events at /api/commerce/webhook (see README).
STRIPE_CONNECT_WEBHOOK_SECRET=

# Approved creator email automations (Resend and verified EMAIL_FROM above).
# A random 32+ character secret protects /api/automations/dispatch. Never expose it.
AUTOMATION_DISPATCH_SECRET=
# Render dispatches durable pending jobs every minute when configured.
# Set false to disable the timer in previews or when using an external scheduler.
AUTOMATIONS_WORKER_ENABLED=true

# Transactional purchase confirmations have an independent production timer.
# Its private loopback credential is generated in memory at server startup.
# No credential setup is needed. Set false to pause purchase email delivery.
PURCHASE_EMAILS_WORKER_ENABLED=true

# Operator-owned workspace addresses such as aagii.fivegen.ai/product1.
# Change the base only to an owned domain connected to this service.
FIVEGEN_WORKSPACE_DOMAIN=fivegen.ai
# Enable only after wildcard DNS, hosting and HTTPS are verified on that base.
# Creators may reserve names while this remains false.
FIVEGEN_WORKSPACE_SUBDOMAINS_READY=false
